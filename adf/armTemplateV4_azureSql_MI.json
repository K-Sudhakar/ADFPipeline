{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "factoryName": {
      "type": "string"
    },
    "factoryLocation": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "blobConnectionString": {
      "type": "securestring"
    },
    "blobContainer": {
      "type": "string",
      "defaultValue": "adf-backup"
    },
    "azureSqlServer": {
      "type": "string",
      "metadata": {
        "description": "Azure SQL logical server name or FQDN, e.g. myserver.database.windows.net"
      }
    },
    "azureSqlDatabase": {
      "type": "string",
      "metadata": {
        "description": "Azure SQL Database name"
      }
    }
  },
  "resources": [
    {
      "name": "[parameters('factoryName')]",
      "type": "Microsoft.DataFactory/factories",
      "apiVersion": "2018-06-01",
      "location": "[parameters('factoryLocation')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {}
    },
    {
      "name": "[concat(parameters('factoryName'), '/LS_OnPremSql')]",
      "type": "Microsoft.DataFactory/factories/linkedServices",
      "apiVersion": "2018-06-01",
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories', parameters('factoryName'))]"
      ],
      "properties": {
        "type": "AzureSqlDatabase",
        "typeProperties": {
          "server": "[parameters('azureSqlServer')]",
          "database": "[parameters('azureSqlDatabase')]",
          "encrypt": "mandatory",
          "trustServerCertificate": false,
          "authenticationType": "SystemAssignedManagedIdentity"
        }
      }
    },
    {
      "name": "[concat(parameters('factoryName'), '/LS_AzureBlob')]",
      "type": "Microsoft.DataFactory/factories/linkedServices",
      "apiVersion": "2018-06-01",
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories', parameters('factoryName'))]"
      ],
      "properties": {
        "type": "AzureBlobStorage",
        "typeProperties": {
          "connectionString": "[parameters('blobConnectionString')]"
        }
      }
    },
    {
      "name": "[concat(parameters('factoryName'), '/DS_OnPremSqlTable')]",
      "type": "Microsoft.DataFactory/factories/datasets",
      "apiVersion": "2018-06-01",
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories/linkedServices', parameters('factoryName'), 'LS_OnPremSql')]"
      ],
      "properties": {
        "type": "AzureSqlTable",
        "parameters": {
          "schemaName": {
            "type": "String"
          },
          "tableName": {
            "type": "String"
          }
        },
        "linkedServiceName": {
          "referenceName": "LS_OnPremSql",
          "type": "LinkedServiceReference"
        },
        "typeProperties": {
          "tableName": "@{dataset().schemaName}.@{dataset().tableName}"
        }
      }
    },
    {
      "name": "[concat(parameters('factoryName'), '/DS_OnPremSqlConfig')]",
      "type": "Microsoft.DataFactory/factories/datasets",
      "apiVersion": "2018-06-01",
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories/linkedServices', parameters('factoryName'), 'LS_OnPremSql')]"
      ],
      "properties": {
        "type": "AzureSqlTable",
        "linkedServiceName": {
          "referenceName": "LS_OnPremSql",
          "type": "LinkedServiceReference"
        },
        "typeProperties": {
          "tableName": "dbo.AdfBackupConfig"
        }
      }
    },
    {
      "name": "[concat(parameters('factoryName'), '/DS_BlobParquet')]",
      "type": "Microsoft.DataFactory/factories/datasets",
      "apiVersion": "2018-06-01",
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories/linkedServices', parameters('factoryName'), 'LS_AzureBlob')]"
      ],
      "properties": {
        "type": "Parquet",
        "parameters": {
          "container": {
            "type": "String"
          },
          "folderPath": {
            "type": "String"
          },
          "fileName": {
            "type": "String"
          }
        },
        "linkedServiceName": {
          "referenceName": "LS_AzureBlob",
          "type": "LinkedServiceReference"
        },
        "typeProperties": {
          "location": {
            "type": "AzureBlobStorageLocation",
            "container": "@dataset().container",
            "folderPath": "@dataset().folderPath",
            "fileName": "@dataset().fileName"
          }
        }
      }
    },
    {
      "name": "[concat(parameters('factoryName'), '/PL_BackupToParquet')]",
      "type": "Microsoft.DataFactory/factories/pipelines",
      "apiVersion": "2018-06-01",
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories/linkedServices', parameters('factoryName'), 'LS_OnPremSql')]",
        "[resourceId('Microsoft.DataFactory/factories/linkedServices', parameters('factoryName'), 'LS_AzureBlob')]",
        "[resourceId('Microsoft.DataFactory/factories/datasets', parameters('factoryName'), 'DS_OnPremSqlConfig')]",
        "[resourceId('Microsoft.DataFactory/factories/datasets', parameters('factoryName'), 'DS_OnPremSqlTable')]",
        "[resourceId('Microsoft.DataFactory/factories/datasets', parameters('factoryName'), 'DS_BlobParquet')]"
      ],
      "properties": {
        "parameters": {
          "StartDate": {
            "type": "String"
          },
          "EndDate": {
            "type": "String"
          },
          "RunId": {
            "type": "String"
          },
          "BlobContainer": {
            "type": "String",
            "defaultValue": "[parameters('blobContainer')]"
          },
          "IsSequential": {
            "type": "Bool",
            "defaultValue": false
          }
        },
        "activities": [
          {
            "name": "Lookup_BackupConfig",
            "type": "Lookup",
            "dependsOn": [],
            "policy": {
              "timeout": "7.00:00:00",
              "retry": 1,
              "retryIntervalInSeconds": 30,
              "secureOutput": false,
              "secureInput": false
            },
            "userProperties": [],
            "typeProperties": {
              "source": {
                "type": "AzureSqlSource",
                "sqlReaderQuery": "SELECT TableSchema, TableName, TargetFolder, FilterColumn, UseDateRange FROM dbo.AdfBackupConfig WHERE BackupEnabled = 1 AND (Enabled = 1 OR Enabled IS NULL)"
              },
              "dataset": {
                "referenceName": "DS_OnPremSqlConfig",
                "type": "DatasetReference"
              },
              "firstRowOnly": false
            }
          },
          {
            "name": "ForEach_Backup",
            "type": "ForEach",
            "dependsOn": [
              {
                "activity": "Lookup_BackupConfig",
                "dependencyConditions": [
                  "Succeeded"
                ]
              }
            ],
            "userProperties": [],
            "typeProperties": {
              "items": "@activity('Lookup_BackupConfig').output.value",
              "isSequential": "@pipeline().parameters.IsSequential",
              "activities": [
                {
                  "name": "Log_Backup_Running",
                  "type": "Script",
                  "dependsOn": [],
                  "policy": {
                    "timeout": "00:30:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                  },
                  "linkedServiceName": {
                    "referenceName": "LS_OnPremSql",
                    "type": "LinkedServiceReference"
                  },
                  "typeProperties": {
                    "scripts": [
                      {
                        "type": "Query",
                        "text": "@{concat('INSERT INTO dbo.AdfOrchestrationRunLog (RunId, OrchestrationName, PipelineName, StepName, TableSchema, TableName, Status, StartTimeUtc, RangeStartUtc, RangeEndUtc, CorrelationId) VALUES (''', pipeline().parameters.RunId, ''', ''Backup'', ''PL_BackupToParquet'', ''Backup'', ''', item().TableSchema, ''', ''', item().TableName, ''', ''Running'', SYSUTCDATETIME(), ''', pipeline().parameters.StartDate, ''', ''', pipeline().parameters.EndDate, ''', ''', pipeline().runId, ''')')}"
                      }
                    ]
                  }
                },
                {
                  "name": "Copy_Table_To_Parquet",
                  "type": "Copy",
                  "dependsOn": [
                    {
                      "activity": "Log_Backup_Running",
                      "dependencyConditions": [
                        "Succeeded"
                      ]
                    }
                  ],
                  "policy": {
                    "timeout": "7.00:00:00",
                    "retry": 1,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                  },
                  "userProperties": [],
                  "typeProperties": {
                    "source": {
                      "type": "AzureSqlSource",
                      "sqlReaderQuery": "@{if(or(equals(item().UseDateRange, 0), equals(item().FilterColumn, null)), concat('SELECT * FROM [', item().TableSchema, '].[', item().TableName, ']'), concat('SELECT * FROM [', item().TableSchema, '].[', item().TableName, '] WHERE [', item().FilterColumn, '] >= ''', pipeline().parameters.StartDate, ''' AND [', item().FilterColumn, '] < ''', pipeline().parameters.EndDate, ''''))}"
                    },
                    "sink": {
                      "type": "ParquetSink",
                      "storeSettings": {
                        "type": "AzureBlobStorageWriteSettings"
                      },
                      "formatSettings": {
                        "type": "ParquetWriteSettings"
                      }
                    },
                    "enableStaging": false
                  },
                  "inputs": [
                    {
                      "referenceName": "DS_OnPremSqlTable",
                      "type": "DatasetReference",
                      "parameters": {
                        "schemaName": "@item().TableSchema",
                        "tableName": "@item().TableName"
                      }
                    }
                  ],
                  "outputs": [
                    {
                      "referenceName": "DS_BlobParquet",
                      "type": "DatasetReference",
                      "parameters": {
                        "container": "@pipeline().parameters.BlobContainer",
                        "folderPath": "@{concat(item().TargetFolder, '/dt=', formatDateTime(pipeline().parameters.StartDate,'yyyyMMdd'), '_', formatDateTime(pipeline().parameters.EndDate,'yyyyMMdd'))}",
                        "fileName": "@{concat(item().TableSchema, '_', item().TableName, '_', formatDateTime(pipeline().parameters.StartDate,'yyyyMMdd'), '_', formatDateTime(pipeline().parameters.EndDate,'yyyyMMdd'), '.parquet')}"
                      }
                    }
                  ]
                },
                {
                  "name": "Log_Backup_Succeeded",
                  "type": "Script",
                  "dependsOn": [
                    {
                      "activity": "Copy_Table_To_Parquet",
                      "dependencyConditions": [
                        "Succeeded"
                      ]
                    }
                  ],
                  "policy": {
                    "timeout": "00:30:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                  },
                  "linkedServiceName": {
                    "referenceName": "LS_OnPremSql",
                    "type": "LinkedServiceReference"
                  },
                  "typeProperties": {
                    "scripts": [
                      {
                        "type": "Query",
                        "text": "@{concat('INSERT INTO dbo.AdfOrchestrationRunLog (RunId, OrchestrationName, PipelineName, StepName, TableSchema, TableName, Status, StartTimeUtc, EndTimeUtc, RangeStartUtc, RangeEndUtc, RowsCopied, OutputFile, CorrelationId) VALUES (''', pipeline().parameters.RunId, ''', ''Backup'', ''PL_BackupToParquet'', ''Backup'', ''', item().TableSchema, ''', ''', item().TableName, ''', ''Succeeded'', SYSUTCDATETIME(), SYSUTCDATETIME(), ''', pipeline().parameters.StartDate, ''', ''', pipeline().parameters.EndDate, ''', ', string(activity('Copy_Table_To_Parquet').output.rowsCopied), ', ''', concat(item().TargetFolder, '/dt=', formatDateTime(pipeline().parameters.StartDate,'yyyyMMdd'), '_', formatDateTime(pipeline().parameters.EndDate,'yyyyMMdd'), '/', item().TableSchema, '_', item().TableName, '_', formatDateTime(pipeline().parameters.StartDate,'yyyyMMdd'), '_', formatDateTime(pipeline().parameters.EndDate,'yyyyMMdd'), '.parquet'), ''', ''', pipeline().runId, ''')')}"
                      }
                    ]
                  }
                },
                {
                  "name": "Log_Backup_Failed",
                  "type": "Script",
                  "dependsOn": [
                    {
                      "activity": "Copy_Table_To_Parquet",
                      "dependencyConditions": [
                        "Failed"
                      ]
                    }
                  ],
                  "policy": {
                    "timeout": "00:30:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                  },
                  "linkedServiceName": {
                    "referenceName": "LS_OnPremSql",
                    "type": "LinkedServiceReference"
                  },
                  "typeProperties": {
                    "scripts": [
                      {
                        "type": "Query",
                        "text": "@{concat('INSERT INTO dbo.AdfOrchestrationRunLog (RunId, OrchestrationName, PipelineName, StepName, TableSchema, TableName, Status, StartTimeUtc, EndTimeUtc, RangeStartUtc, RangeEndUtc, ErrorCode, ErrorMessage, CorrelationId) VALUES (''', pipeline().parameters.RunId, ''', ''Backup'', ''PL_BackupToParquet'', ''Backup'', ''', item().TableSchema, ''', ''', item().TableName, ''', ''Failed'', SYSUTCDATETIME(), SYSUTCDATETIME(), ''', pipeline().parameters.StartDate, ''', ''', pipeline().parameters.EndDate, ''', ''', activity('Copy_Table_To_Parquet').error.errorCode, ''', ''', replace(activity('Copy_Table_To_Parquet').error.message, '''', '\"\"'), ''', ''', pipeline().runId, ''')')}"
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "name": "[concat(parameters('factoryName'), '/PL_DeleteRecords')]",
      "type": "Microsoft.DataFactory/factories/pipelines",
      "apiVersion": "2018-06-01",
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories/linkedServices', parameters('factoryName'), 'LS_OnPremSql')]",
        "[resourceId('Microsoft.DataFactory/factories/datasets', parameters('factoryName'), 'DS_OnPremSqlConfig')]"
      ],
      "properties": {
        "parameters": {
          "StartDate": {
            "type": "String"
          },
          "EndDate": {
            "type": "String"
          },
          "RunId": {
            "type": "String"
          },
          "IsSequential": {
            "type": "Bool",
            "defaultValue": true
          }
        },
        "activities": [
          {
            "name": "Lookup_DeleteConfig",
            "type": "Lookup",
            "dependsOn": [],
            "policy": {
              "timeout": "7.00:00:00",
              "retry": 1,
              "retryIntervalInSeconds": 30,
              "secureOutput": false,
              "secureInput": false
            },
            "userProperties": [],
            "typeProperties": {
              "source": {
                "type": "AzureSqlSource",
                "sqlReaderQuery": "SELECT TableSchema, TableName, FilterColumn, UseDateRange, AllowFullDelete FROM dbo.AdfBackupConfig WHERE DeleteEnabled = 1 AND (Enabled = 1 OR Enabled IS NULL)"
              },
              "dataset": {
                "referenceName": "DS_OnPremSqlConfig",
                "type": "DatasetReference"
              },
              "firstRowOnly": false
            }
          },
          {
            "name": "ForEach_Delete",
            "type": "ForEach",
            "dependsOn": [
              {
                "activity": "Lookup_DeleteConfig",
                "dependencyConditions": [
                  "Succeeded"
                ]
              }
            ],
            "userProperties": [],
            "typeProperties": {
              "items": "@activity('Lookup_DeleteConfig').output.value",
              "isSequential": "@pipeline().parameters.IsSequential",
              "activities": [
                {
                  "name": "Log_Delete_Running",
                  "type": "Script",
                  "dependsOn": [],
                  "policy": {
                    "timeout": "00:30:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                  },
                  "linkedServiceName": {
                    "referenceName": "LS_OnPremSql",
                    "type": "LinkedServiceReference"
                  },
                  "typeProperties": {
                    "scripts": [
                      {
                        "type": "Query",
                        "text": "@{concat('INSERT INTO dbo.AdfOrchestrationRunLog (RunId, OrchestrationName, PipelineName, StepName, TableSchema, TableName, Status, StartTimeUtc, RangeStartUtc, RangeEndUtc, CorrelationId) VALUES (''', pipeline().parameters.RunId, ''', ''Delete'', ''PL_DeleteRecords'', ''Delete'', ''', item().TableSchema, ''', ''', item().TableName, ''', ''Running'', SYSUTCDATETIME(), ''', pipeline().parameters.StartDate, ''', ''', pipeline().parameters.EndDate, ''', ''', pipeline().runId, ''')')}"
                      }
                    ]
                  }
                },
                {
                  "name": "If_Delete_With_Filter",
                  "type": "IfCondition",
                  "dependsOn": [
                    {
                      "activity": "Log_Delete_Running",
                      "dependencyConditions": [
                        "Succeeded"
                      ]
                    }
                  ],
                  "typeProperties": {
                    "expression": {
                      "value": "@and(equals(item().UseDateRange, 1), not(equals(item().FilterColumn, null)))",
                      "type": "Expression"
                    },
                    "ifTrueActivities": [
                      {
                        "name": "Delete_Rows_Filtered",
                        "type": "Script",
                        "policy": {
                          "timeout": "00:30:00",
                          "retry": 0,
                          "retryIntervalInSeconds": 30,
                          "secureOutput": false,
                          "secureInput": false
                        },
                        "linkedServiceName": {
                          "referenceName": "LS_OnPremSql",
                          "type": "LinkedServiceReference"
                        },
                        "typeProperties": {
                          "scripts": [
                            {
                              "type": "Query",
                              "text": "@{concat('DELETE FROM [', item().TableSchema, '].[', item().TableName, '] WHERE [', item().FilterColumn, '] >= ''', pipeline().parameters.StartDate, ''' AND [', item().FilterColumn, '] < ''', pipeline().parameters.EndDate, '''')}"
                            }
                          ]
                        }
                      },
                      {
                        "name": "Log_Delete_Succeeded_Filtered",
                        "type": "Script",
                        "dependsOn": [
                          {
                            "activity": "Delete_Rows_Filtered",
                            "dependencyConditions": [
                              "Succeeded"
                            ]
                          }
                        ],
                        "policy": {
                          "timeout": "00:30:00",
                          "retry": 0,
                          "retryIntervalInSeconds": 30,
                          "secureOutput": false,
                          "secureInput": false
                        },
                        "linkedServiceName": {
                          "referenceName": "LS_OnPremSql",
                          "type": "LinkedServiceReference"
                        },
                        "typeProperties": {
                          "scripts": [
                            {
                              "type": "Query",
                              "text": "@{concat('INSERT INTO dbo.AdfOrchestrationRunLog (RunId, OrchestrationName, PipelineName, StepName, TableSchema, TableName, Status, StartTimeUtc, EndTimeUtc, RangeStartUtc, RangeEndUtc, RowsDeleted, CorrelationId) VALUES (''', pipeline().parameters.RunId, ''', ''Delete'', ''PL_DeleteRecords'', ''Delete'', ''', item().TableSchema, ''', ''', item().TableName, ''', ''Succeeded'', SYSUTCDATETIME(), SYSUTCDATETIME(), ''', pipeline().parameters.StartDate, ''', ''', pipeline().parameters.EndDate, ''', NULL, ''', pipeline().runId, ''')')}"
                            }
                          ]
                        }
                      },
                      {
                        "name": "Log_Delete_Failed_Filtered",
                        "type": "Script",
                        "dependsOn": [
                          {
                            "activity": "Delete_Rows_Filtered",
                            "dependencyConditions": [
                              "Failed"
                            ]
                          }
                        ],
                        "policy": {
                          "timeout": "00:30:00",
                          "retry": 0,
                          "retryIntervalInSeconds": 30,
                          "secureOutput": false,
                          "secureInput": false
                        },
                        "linkedServiceName": {
                          "referenceName": "LS_OnPremSql",
                          "type": "LinkedServiceReference"
                        },
                        "typeProperties": {
                          "scripts": [
                            {
                              "type": "Query",
                              "text": "@{concat('INSERT INTO dbo.AdfOrchestrationRunLog (RunId, OrchestrationName, PipelineName, StepName, TableSchema, TableName, Status, StartTimeUtc, EndTimeUtc, RangeStartUtc, RangeEndUtc, ErrorCode, ErrorMessage, CorrelationId) VALUES (''', pipeline().parameters.RunId, ''', ''Delete'', ''PL_DeleteRecords'', ''Delete'', ''', item().TableSchema, ''', ''', item().TableName, ''', ''Failed'', SYSUTCDATETIME(), SYSUTCDATETIME(), ''', pipeline().parameters.StartDate, ''', ''', pipeline().parameters.EndDate, ''', ''', activity('Delete_Rows_Filtered').error.errorCode, ''', ''', replace(activity('Delete_Rows_Filtered').error.message, '''', '\"\"'), ''', ''', pipeline().runId, ''')')}"
                            }
                          ]
                        }
                      }
                    ],
                    "ifFalseActivities": [
                      {
                        "name": "If_Allow_Full_Delete",
                        "type": "IfCondition",
                        "typeProperties": {
                          "expression": {
                            "value": "@equals(item().AllowFullDelete, 1)",
                            "type": "Expression"
                          },
                          "ifTrueActivities": [
                            {
                              "name": "Delete_Rows_Full",
                              "type": "Script",
                              "policy": {
                                "timeout": "00:30:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                              },
                              "linkedServiceName": {
                                "referenceName": "LS_OnPremSql",
                                "type": "LinkedServiceReference"
                              },
                              "typeProperties": {
                                "scripts": [
                                  {
                                    "type": "Query",
                                    "text": "@{concat('DELETE FROM [', item().TableSchema, '].[', item().TableName, ']')}"
                                  }
                                ]
                              }
                            },
                            {
                              "name": "Log_Delete_Succeeded_Full",
                              "type": "Script",
                              "dependsOn": [
                                {
                                  "activity": "Delete_Rows_Full",
                                  "dependencyConditions": [
                                    "Succeeded"
                                  ]
                                }
                              ],
                              "policy": {
                                "timeout": "00:30:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                              },
                              "linkedServiceName": {
                                "referenceName": "LS_OnPremSql",
                                "type": "LinkedServiceReference"
                              },
                              "typeProperties": {
                                "scripts": [
                                  {
                                    "type": "Query",
                                    "text": "@{concat('INSERT INTO dbo.AdfOrchestrationRunLog (RunId, OrchestrationName, PipelineName, StepName, TableSchema, TableName, Status, StartTimeUtc, EndTimeUtc, RangeStartUtc, RangeEndUtc, RowsDeleted, CorrelationId) VALUES (''', pipeline().parameters.RunId, ''', ''Delete'', ''PL_DeleteRecords'', ''Delete'', ''', item().TableSchema, ''', ''', item().TableName, ''', ''Succeeded'', SYSUTCDATETIME(), SYSUTCDATETIME(), ''', pipeline().parameters.StartDate, ''', ''', pipeline().parameters.EndDate, ''', NULL, ''', pipeline().runId, ''')')}"
                                  }
                                ]
                              }
                            },
                            {
                              "name": "Log_Delete_Failed_Full",
                              "type": "Script",
                              "dependsOn": [
                                {
                                  "activity": "Delete_Rows_Full",
                                  "dependencyConditions": [
                                    "Failed"
                                  ]
                                }
                              ],
                              "policy": {
                                "timeout": "00:30:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                              },
                              "linkedServiceName": {
                                "referenceName": "LS_OnPremSql",
                                "type": "LinkedServiceReference"
                              },
                              "typeProperties": {
                                "scripts": [
                                  {
                                    "type": "Query",
                                    "text": "@{concat('INSERT INTO dbo.AdfOrchestrationRunLog (RunId, OrchestrationName, PipelineName, StepName, TableSchema, TableName, Status, StartTimeUtc, EndTimeUtc, RangeStartUtc, RangeEndUtc, ErrorCode, ErrorMessage, CorrelationId) VALUES (''', pipeline().parameters.RunId, ''', ''Delete'', ''PL_DeleteRecords'', ''Delete'', ''', item().TableSchema, ''', ''', item().TableName, ''', ''Failed'', SYSUTCDATETIME(), SYSUTCDATETIME(), ''', pipeline().parameters.StartDate, ''', ''', pipeline().parameters.EndDate, ''', ''', activity('Delete_Rows_Full').error.errorCode, ''', ''', replace(activity('Delete_Rows_Full').error.message, '''', '\"\"'), ''', ''', pipeline().runId, ''')')}"
                                  }
                                ]
                              }
                            }
                          ],
                          "ifFalseActivities": [
                            {
                              "name": "Log_Delete_Blocked",
                              "type": "Script",
                              "policy": {
                                "timeout": "00:30:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                              },
                              "linkedServiceName": {
                                "referenceName": "LS_OnPremSql",
                                "type": "LinkedServiceReference"
                              },
                              "typeProperties": {
                                "scripts": [
                                  {
                                    "type": "Query",
                                    "text": "@{concat('INSERT INTO dbo.AdfOrchestrationRunLog (RunId, OrchestrationName, PipelineName, StepName, TableSchema, TableName, Status, StartTimeUtc, EndTimeUtc, RangeStartUtc, RangeEndUtc, ErrorCode, ErrorMessage, CorrelationId) VALUES (''', pipeline().parameters.RunId, ''', ''Delete'', ''PL_DeleteRecords'', ''Delete'', ''', item().TableSchema, ''', ''', item().TableName, ''', ''Failed'', SYSUTCDATETIME(), SYSUTCDATETIME(), ''', pipeline().parameters.StartDate, ''', ''', pipeline().parameters.EndDate, ''', ''FULL_DELETE_BLOCKED'', ''Full-table delete is blocked. Set UseDateRange=1 with FilterColumn or AllowFullDelete=1 in dbo.AdfBackupConfig.'', ''', pipeline().runId, ''')')}"
                                  }
                                ]
                              }
                            },
                            {
                              "name": "Fail_Delete_Not_Allowed",
                              "type": "Fail",
                              "dependsOn": [
                                {
                                  "activity": "Log_Delete_Blocked",
                                  "dependencyConditions": [
                                    "Succeeded"
                                  ]
                                }
                              ],
                              "typeProperties": {
                                "message": "Full-table delete is blocked. Set UseDateRange=1 with FilterColumn or AllowFullDelete=1 in dbo.AdfBackupConfig.",
                                "errorCode": "FULL_DELETE_BLOCKED"
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "name": "[concat(parameters('factoryName'), '/PL_RestoreFromParquet')]",
      "type": "Microsoft.DataFactory/factories/pipelines",
